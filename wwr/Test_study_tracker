def test_time_per_subject():
    sessions = [
        {
            "Date": "2026-10-01",
            "Subject": "Python",
            "Minutes Studied": 60
        },
        {
            "Date": "2026-10-01",
            "Subject": "Math",
            "Minutes Studied": 40
        },
        {
            "Date": "2026-10-02",
            "Subject": "Python",
            "Minutes Studied": 30
        },
        {
            "Date": "2026-10-02",
            "Subject": "Math",
            "Minutes Studied": 20
        }
    ]

    expected = {
        "Python": 90,
        "Math": 60
    }

    assert time_per_subject(sessions) == expected
