from study_tracker import (
    calculate_total_time,
    calculate_average_session,
    time_per_subject
)


def test_calculate_total_time():
    sessions = [
        {
            "Date": "2026-10-01",
            "Subject": "Python",
            "Minutes Studied": 60
        },
        {
            "Date": "2026-10-01",
            "Subject": "Math",
            "Minutes Studied": 40
        },
        {
            "Date": "2026-10-02",
            "Subject": "Python",
            "Minutes Studied": 30
        }
    ]

    assert calculate_total_time(sessions) == 130


